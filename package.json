{
  "name": "petripals",
  "version": "1.0.0",
  "private": true,
  "description": "A cartoon microbe buddy game with an Express + TypeScript server",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
